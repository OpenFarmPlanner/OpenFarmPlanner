# Example .env for OpenFarmPlanner Django backend
# Copy this file to backend/.env and adjust values for your deployment

DEBUG=False
DJANGO_ENV=development
SECRET_KEY=please_change_me_in_prod

# Allowed hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,example.com,www.example.com

# Optional local LAN development hosts. Used only with DEBUG=True and
# DJANGO_ENV=development, for example when testing from a phone.
# DEV_LAN_HOSTS=192.168.178.125

# Guest demo start rate limit. Defaults to 1000/minute when DJANGO_ENV=development
# and to 10/hour otherwise. Keep production restrictive unless you deliberately
# choose a different protection level.
# GUEST_DEMO_THROTTLE_RATE=1000/minute

# CORS and CSRF settings (comma-separated)
CORS_ALLOWED_ORIGINS=https://example.com,http://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,http://www.example.com

# Proxy / HTTPS settings for deployments behind a reverse proxy
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
USE_X_FORWARDED_HOST=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# Database settings
DB_NAME=farmplanner_db
DB_USER=farmplanner
DB_PASSWORD=farmplanner
DB_HOST=localhost
DB_PORT=5432

# Recipient for informational new-user emails (default: info@openfarmplanner.org).
# Leave empty to disable these notifications.
ADMIN_NOTIFICATION_EMAIL=info@openfarmplanner.org

# Optional backend prefix for legacy/subpath deployments
URL_PREFIX=openfarmplanner

# Optional shared Channels layer. Leave unset for the process-local in-memory
# layer in development/tests. Required for multi-process staging/production.
# CHANNEL_REDIS_URL=redis://username:password@redis-host:6379/0

# Social login (Google / Microsoft) — see docs/social-login.md.
# A provider without both client id and secret is simply not offered; email
# and password login keeps working either way. Never commit real secrets.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
#
# Microsoft tenant: "common" accepts personal Microsoft accounts and
# Microsoft 365 / Entra ID work accounts, "consumers" only personal accounts,
# "organizations" only work accounts, or a specific tenant id.
# MICROSOFT_OAUTH_TENANT=common
#
# Origin the browser reaches the API under; the OAuth redirect URIs are built
# from it and must match what is registered at Google/Microsoft. Defaults to
# PUBLIC_FRONTEND_URL, which is correct whenever the SPA and the API share an
# origin (including the Vite dev-server proxy). Run
# `pdm run python manage.py show_social_login_config` to print the resulting
# redirect URIs.
# SOCIAL_AUTH_CALLBACK_BASE_URL=https://openfarmplanner.org
